{
  "name": "keycalendar",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {"node": ">=24"},
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev -w @keycalendar/api",
    "dev:web": "npm run dev -w @keycalendar/web",
    "db:migrate": "npm run db:migrate -w @keycalendar/api"
  }
}
